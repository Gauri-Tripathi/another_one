{
  "name": "purrductive",
  "version": "0.9.0",
  "private": true,
  "author": "Purrductive",
  "description": "A local-first screen-time tracker with a very persuasive cat.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 0.0.0.0\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start": "electron .",
    "dist": "npm run build && electron-builder --win nsis",
    "build:mac-helper": "node scripts/build-mac-helper.cjs",
    "dev:mac": "npm run build:mac-helper && npm run dev",
    "dist:mac": "npm run build:mac-helper && npm run build && electron-builder --mac dmg zip --arm64 --x64 --publish never",
    "test": "node --test tests/*.test.cjs"
  },
  "build": {
    "appId": "com.purrductive.app",
    "productName": "Purrductive",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "public/cat-coach.png"
    },
    "mac": {
      "target": ["dmg", "zip"],
      "category": "public.app-category.productivity",
      "minimumSystemVersion": "13.0",
      "artifactName": "Purrductive-${version}-mac-${arch}.${ext}",
      "icon": "public/cat-coach.png",
      "hardenedRuntime": true,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "extraResources": [{"from":"build/mac/purrductive-foreground","to":"mac/purrductive-foreground"}],
      "binaries": ["Contents/Resources/mac/purrductive-foreground"]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@supabase/supabase-js": "latest",
    "lucide-react": "latest",
    "qrcode": "^1.5.4",
    "react": "latest",
    "react-dom": "latest"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "latest",
    "concurrently": "latest",
    "cross-env": "latest",
    "electron": "latest",
    "electron-builder": "latest",
    "vite": "latest",
    "wait-on": "latest"
  }
}
